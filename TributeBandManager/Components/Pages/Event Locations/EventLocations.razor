@page "/eventlocations"

@* Sets the render mode to Interactive Server for this entire component 
    Recommended to specify the render mode outside of the component*@
@* @rendermode InteractiveServer *@

@using TributeBandManager.Components.Models
@using TributeBandManager.Components.Models.EventLocations
@inject NavigationManager NavigationManager

<h3>EventLocations</h3>
<br />
<br />
<div class="container-fluid text-center">
    <div class="row w-50">
        @foreach (string cityName in eventLocationsByCity.Keys)
        {
            <div class="col">
                <div class="card @(cityName == selectedCity ? "border-primary" : string.Empty)">
                    <div class="card-body">
                        <button type="button" class="btn btn-primary" @onclick="() => SelectCity(cityName)">@cityName</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<br />

<div class="input-group mb-3">
    <input type="text" class="form-control" @bind-value="searchFilter" @bind-value:event="oninput" />
    <button class="btn btn-outline-secondary" type="button" id="button-search" @onclick="HandleEventLocationSerach">Search</button>
</div>

<br />

<ul>
    <Virtualize Items="eventLocations" Context="eventLocation">
        @* The (unique) key is used to identify each object, so that the entire list must not be updated constantly when changes occur. *@
        <li @key="eventLocation.Id">
            @eventLocation.Name in @eventLocation.City is @eventLocation.Distance km away.
            <span style="color:@(((eventLocation.Distance > 0) ? "red" : "green"))">
                @(eventLocation.Distance > 0 ? "far away" : "right here")
            </span>
            &nbsp;
            <a href="/eventlocations/@eventLocation.Id" class="btn btn-link">Edit</a>
            &nbsp;
            <EditForm Model="eventLocation"
                      FormName=@($"form-eventlocation-{eventLocation.Id}")
                      OnValidSubmit="() => DeleteEventLocation(eventLocation.Id)">
                <button type="submit" class="btn btn-primary">Delete</button>
            </EditForm>
        </li>
    </Virtualize>
</ul>

<p>
    <a href="/eventlocations/add" class="btn btn-primary">Add Event Location</a>
</p>

@code {
    private List<EventLocation> eventLocations = EventLocationsRepository.GetEventLocations();
    private Dictionary<string, List<EventLocation>> eventLocationsByCity;
    private string selectedCity = "Andernach";
    private string _searchFilter = string.Empty;
    private string searchFilter
    {
        get
        {
            return _searchFilter;
        }
        set
        {
            _searchFilter = value;
            eventLocations = EventLocationsRepository.SearchEventLocations(searchFilter);
        }
    }

    protected override void OnInitialized()
    {
        eventLocationsByCity = eventLocations
            .GroupBy(e => e.City ?? "unknown")
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private void SelectCity(string city)
    {
        selectedCity = city;

        eventLocations = EventLocationsRepository.GetEventLocationsByCity(selectedCity);
    }

    private void DeleteEventLocation(int eventLocationId)
    {
        if (eventLocationId > 0)
        {
            EventLocationsRepository.DeleteEventLocation(eventLocationId);
        }
    }

    private void HandleEventLocationSerach()
    {
        eventLocations = EventLocationsRepository.SearchEventLocations(searchFilter);

        selectedCity = string.Empty;
    }
}
