@page "/todolist"
@using TributeBandManager.Components.Models.ToDos

<h3>To Do</h3>

@if (tasks != null)
{
    @foreach (ToDo task in tasks)
    {
        <p>@task.Name</p>
    }
}

<button @onclick="AddTask"> Add Task </button>

@code {
    private List<ToDo> tasks = ToDoRepository.GetToDos();

    private void AddTask()
    {
        ToDoRepository.AddToDo();
        tasks = ToDoRepository.GetToDos().OrderByDescending(tasks => tasks.Id).ToList();
    }
}
