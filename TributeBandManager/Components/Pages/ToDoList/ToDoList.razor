@page "/todolist"
@inject NavigationManager NavigationManager
@using TributeBandManager.Components.Models.ToDos

<h3>To Do</h3>
<br />

<button class="btn btn-primary" type="button" id="button-add" @onclick="AddTask"> Add Task </button>
<br />
@if (tasks != null && tasks.Count > 0)
{
    <ul>
        @foreach (ToDoItem task in tasks)
        {
            <li @key="task" class="mb-2">
                <div class="d-flex align-items-center">
                    <InputCheckbox id="@($"todo-{task.Id}")" @bind-Value="task.Completed" @onclick="(() => SetTaskCompleted(task))" />
                    <InputText disabled="@task.Completed" @bind-Value="@task.Name" class="ms-2" for="@($"todo-{task.Id}")" style="@(task.Completed ? "text-decoration: line-through" : "")"></InputText>
                    @if (task.Completed)
                    {
                        <label>@task.TimeStampCompleted</label>
                    }
                </div>
            </li>
        }
    </ul>
}

@code {
    private List<ToDoItem> tasks = ToDoItemRepository.GetToDos();

    private void AddTask()
    {
        ToDoItemRepository.AddToDo(new ToDoItem { });
        tasks = ToDoItemRepository.GetToDos();
    }

    private void SetTaskCompleted(ToDoItem task)
    {
        task.TimeStampCompleted = DateTime.Now;
    }
}
