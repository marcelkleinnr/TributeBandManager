@page "/todolist/add"
@inject NavigationManager NavigationManager
@using TributeBandManager.Components.Models.ToDos

<h3>AddToDo</h3>

<EditForm Model="ToDo" OnValidSubmit="Submit">
    <DataAnnotationsValidator></DataAnnotationsValidator>
    <ValidationSummary></ValidationSummary>
    <InputNumber @bind-Value="ToDo.Id" hidden></InputNumber>
    <div class="row mb-3">
        <div class="col-2">
            <label class="col-form-label">Name</label>
        </div>
        <div class="col-6">
            <InputText @bind-Value="ToDo.Name" class="form-control"></InputText>
        </div>
        <div class="col">
            <ValidationMessage For="() => ToDo.Name"></ValidationMessage>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-2">
            <label class="col-form-label">City</label>
        </div>
        <div class="col-6">
            <InputCheckbox @bind-Value="ToDo.Completed" class="form-control"></InputCheckbox>
        </div>
        <div class="col">
            <ValidationMessage For="() => ToDo.Completed"></ValidationMessage>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-2">
            <label class="col-form-label">Region</label>
        </div>
        <div class="col-6">
            <InputDate @bind-Value="ToDo.TimeStampCompleted" class="form-control"></InputDate>
        </div>
        <div class="col">
            <ValidationMessage For="() => ToDo.TimeStampCompleted"></ValidationMessage>
        </div>
    </div>
    <br />
    <button class="btn btn-primary" type="submit">Save</button>
    <br />
    <br />
    <a href="/eventlocations" class="btn btn-primary">Close</a>
</EditForm>

@code {
    private ToDo ToDo { get; set; } = new ToDo { Completed = false };
    private const string formName = "formToDo";

    private void Submit()
    {
        if (ToDo != null)
        {
            ToDoRepository.AddToDo(ToDo);
            NavigationManager.NavigateTo("/todolist");
        }
    }
}
