@page "/eventlocations"
@using TributeBandManager.Components.Models

<h3>EventLocations</h3>
<br />
<br />
<div class="container-fluid text-center">
    <div class="row w-50">
        @foreach (string cityName in eventLocationsByCity.Keys)
        {
            <div class="col">
                <button type="button" class="btn btn-primary" @onclick="() => SetSelectedCity(cityName)">@cityName</button>
            </div>
        }
    </div>
</div>

<br />
<br />

<ul>
    @foreach (EventLocation eventLocation in eventLocations.Where(e => e.City == selectedCity))
    {
        <li>@eventLocation.Name in @eventLocation.City is @eventLocation.Distance km away.</li>
    }
</ul>

@code {
    private List<EventLocation> eventLocations = EventLocationsRepository.GetEventLocations();
    private Dictionary<string, List<EventLocation>> eventLocationsByCity;
    private string selectedCity = string.Empty;

    protected override void OnInitialized()
    {
        eventLocationsByCity = eventLocations
            .GroupBy(e => e.City ?? "unknown")
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private void SetSelectedCity(string city)
    {
        selectedCity = city;
    }
}
